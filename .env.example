NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/installation

# Same SSO_SECRET as Centralisation (P&L) — used to mint P&L consume codes.
# Define once only (duplicate SSO_SECRET= lines break P&L open with error=sso).
SSO_SECRET=
PNL_PUBLIC_URL=http://localhost:3000
# Optional: same Postgres as P&L so portal accepts existing P&L passwords
PNL_DATABASE_URL=

# Portal access lists (mirrors former Centralisation CENTRAL_* envs)
PRIMARY_SUPER_ADMIN_EMAIL=
CENTRAL_BOTH_EMAILS=
CENTRAL_PNL_EMAILS=
CENTRAL_WORKSPACE_EMAILS=
# When email not listed: grant P&L by default (set false to require explicit list)
CENTRAL_PNL_DEFAULT=true

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
