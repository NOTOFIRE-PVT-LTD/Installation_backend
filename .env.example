NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/installation

# Same SSO_SECRET as Centralisation (P&L) — used to mint P&L consume codes.
# Define once only (duplicate SSO_SECRET= lines break P&L open with error=sso).
SSO_SECRET=
# Browser-facing P&L origin (SSO redirect). On EC2 with P&L at / use http://SERVER_IP
PNL_PUBLIC_URL=http://localhost:3000
# Optional loopback for server→P&L OTP proxy (recommended on EC2: http://127.0.0.1:3000)
PNL_INTERNAL_URL=
# Optional: same Postgres as P&L so portal accepts existing P&L passwords
PNL_DATABASE_URL=

# Portal access lists (mirrors former Centralisation CENTRAL_* envs)
PRIMARY_SUPER_ADMIN_EMAIL=
CENTRAL_BOTH_EMAILS=
CENTRAL_PNL_EMAILS=
CENTRAL_WORKSPACE_EMAILS=
# Workspace users get P&L only when true (or listed). P&L-only shadows use portalSource=pnl.
CENTRAL_PNL_DEFAULT=false

# Cookie for refresh token (EC2 http same-host example):
# AUTH_COOKIE_PATH=/ws-api/auth
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/auth
COOKIE_SECURE=
COOKIE_SAME_SITE=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
